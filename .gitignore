# -----------------------------
# Checkpoints
# -----------------------------
# Ignore checkpoint binaries by extension, wherever they live (including
# inside checkpoints/) -- NOT a blanket "checkpoints/" directory rule,
# which was silently also catching real metadata sidecars like
# checkpoints/*/best_val_meta.json (small, useful, meant to be tracked).
*.ckpt
*.pth
*.pt
*.onnx

# -----------------------------
# Datasets
# -----------------------------
data/raw/
data/processed/
data/interim/

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# -----------------------------
# MediaPipe Models
# -----------------------------
models/*.task

# -----------------------------
# Generated files
# -----------------------------
*.npz
*.npy
*.csv
*.pkl
*.pickle

# -----------------------------
# Images & Videos
# -----------------------------
*.mp4
*.avi
*.mov
*.mkv
*.gif

# Ignore generated images
test.png
test_face.png

# -----------------------------
# Jupyter
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# Environment files
# -----------------------------
.env
.env.*

# -----------------------------
